# Public frontend configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key
REACT_APP_SANAYATECHS_SERVICE_MAX_UPLOAD_MB=3

# Server-only service request configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SANAYATECHS_SERVICE_EMAILS=info@sanayatechs.iq,salam.adil@sanayatechs.iq
SANAYATECHS_SERVICE_FROM_EMAIL=no-reply@sanayatechs.iq
SANAYATECHS_SERVICE_REPLY_TO=info@sanayatechs.iq
SANAYATECHS_SERVICE_TIMEZONE=Asia/Baghdad
SANAYATECHS_SERVICE_MAX_UPLOAD_MB=3
SANAYATECHS_SERVICE_ALLOWED_ATTACHMENT_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/plain
SANAYATECHS_SERVICE_RATE_LIMIT_MAX=5
SANAYATECHS_SERVICE_RATE_LIMIT_WINDOW_SECONDS=900
SANAYATECHS_SERVICE_RATE_LIMIT_SALT=replace-with-a-long-random-value
SANAYATECHS_SERVICE_ALLOWED_ORIGINS=https://www.sanayatechs.com,https://sanayatechs.com,https://www.sanayatechs.iq,https://sanayatechs.iq

# SMTP credentials must only be configured on the server
SANAYATECHS_SERVICE_SMTP_HOST=mail.sanayatechs.iq
SANAYATECHS_SERVICE_SMTP_PORT=587
SANAYATECHS_SERVICE_SMTP_SECURE=false
SANAYATECHS_SERVICE_SMTP_USER=
SANAYATECHS_SERVICE_SMTP_PASS=
